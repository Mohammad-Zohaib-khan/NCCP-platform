# ==============================================================================
# NCCP Production Deployment Environment Configuration
# ==============================================================================

# Application Environment ('production' | 'staging' | 'development')
NODE_ENV=production

# Database Configuration
POSTGRES_DB=nccp
POSTGRES_USER=nccp
POSTGRES_PASSWORD=nccp_secure_prod_password_2026!
DATABASE_URL=postgres://nccp:nccp_secure_prod_password_2026!@db:5432/nccp
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Domains and Origins (comma-separated origins)
APP_BASE_URL=https://nccp.gov.in
FRONTEND_ORIGINS=https://nccp.gov.in,http://localhost:3000

# Security and Authentication Secrets (Must be min 32 chars and distinct!)
AUTH_JWT_SECRET=super-secure-production-jwt-secret-key-32chars-min-nccp-2026
AUTH_COOKIE_SECRET=super-secure-production-cookie-secret-key-32chars-min-nccp-2026
AUTH_MFA_ENCRYPTION_KEY=super-secure-production-mfa-encryption-key-32chars-nccp
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=14

# Feature Flags
FEATURE_QR_ATTENDANCE=true
FEATURE_FACE_ATTENDANCE=false
FEATURE_FINGERPRINT_DEMO=false

# Localization
I18N_DEFAULT_LANGUAGE=en
I18N_ENABLED_LANGUAGES=en,hi

# Logging & Proxying
LOG_LEVEL=info
TRUST_PROXY=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Frontend Settings
VITE_API_BASE_URL=/api/v1
PORT=3000
