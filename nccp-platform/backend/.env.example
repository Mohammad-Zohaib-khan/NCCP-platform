# ---- Runtime ----
NODE_ENV=development            # development | test | staging | production
PORT=8080                       # platform-provided PORT is honoured
HOST=0.0.0.0
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent

# ---- Database (required) ----
DATABASE_URL=postgres://nccp:nccp@localhost:5432/nccp
DATABASE_POOL_MAX=10
DATABASE_SSL=false              # true for managed Postgres that requires TLS

# ---- Web ----
# Comma-separated list of exact frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false               # true when behind a load balancer / reverse proxy
RATE_LIMIT_MAX=300              # requests per window per IP (global)
RATE_LIMIT_WINDOW=1 minute

# ---- Auth secrets (used from Part 2 onwards; validated in production now) ----
# Generate: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-in-real-environments-min-32-chars
AUTH_COOKIE_SECRET=change-me-in-real-environments-min-32-chars-b
AUTH_MFA_ENCRYPTION_KEY=       # optional, >=32 chars; encrypts TOTP secrets at rest (falls back to AUTH_JWT_SECRET)
AUTH_ACCESS_TTL_SECONDS=900    # access token lifetime
AUTH_REFRESH_TTL_DAYS=14       # refresh session lifetime (rotated on every use)
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_COOKIE_SAMESITE=lax        # strict | lax | none (none needed if frontend and API are on different sites; forces Secure)
AUTH_COOKIE_SECURE=            # default: true in staging/production, false otherwise
APP_BASE_URL=http://localhost:3000   # used in invitation / reset links

# ---- Attendance features and languages (Part 4 revision) ----
FEATURE_QR_ATTENDANCE=true
FEATURE_FACE_ATTENDANCE=false     # optional; no provider ships, stays unavailable until one is wired and reviewed
FEATURE_FINGERPRINT_DEMO=false    # development/demo Space-key simulator; startup FAILS if true in production
I18N_DEFAULT_LANGUAGE=en
I18N_ENABLED_LANGUAGES=en,hi

# ---- Optional (later parts) ----
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_URL=
