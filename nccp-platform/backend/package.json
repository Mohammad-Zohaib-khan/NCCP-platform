{
  "name": "nccp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NCCP production backend API (Node.js / TypeScript / PostgreSQL)",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:prod": "node dist/db/migrate.js up",
    "test": "node --import tsx --test test/*.test.ts test/integration/*.test.ts",
    "lint:sql": "node scripts/lint-migrations.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:demo": "node scripts/seed-demo-users.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
